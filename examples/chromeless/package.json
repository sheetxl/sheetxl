    "@sheetxl/sdk": "^1.0.0",
    "@sheetxl/utils": "workspace:*",
    "@sheetxl/utils-react": "workspace:*",
    "csstype": "^3.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
