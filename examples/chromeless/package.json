{
  "name": "example-chromeless",
  "description": "Example project for the chromeless (framework-neutral) SheetXL WorkbookElement",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf ./build",
    "clean:all": "git clean -fdX .",
