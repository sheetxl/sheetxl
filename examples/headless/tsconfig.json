{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "paths": {
      "@sheetxl/primitives": [
        "../../packages/primitives/src"
      ],
      "@sheetxl/utils": [
        "../../packages/utils/src"
      ],
      "@sheetxl/io": [
        "../../packages/io/src"
      ]
    },
    "tsBuildInfoFile": "./build/.tsbuildinfo.headless",
    "noEmit": true,
    "composite": false
  },
  "include": [
    "./src",
    "../../packages/primitives/src",
    "../../packages/utils/src",
    "../../packages/sdk/src",
    "../../packages/io/src",
    "../../packages/io-xlsx/src"
  ],
  "exclude": [
    "**.test.**",
    "**/__tests__/**",
    "../../packages/**/__tests__/**",
    "../../packages/**/*.test.*",
    "**/.pnpm",
    "**/build",
    "**/dist",
    "**/node_modules"
  ]
}
