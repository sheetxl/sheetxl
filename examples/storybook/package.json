{
  "name": "example-storybook",
  "description": "Example project for SheetXL Studio using MUI",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "preview": "http-server ./build --cors --host 0.0.0.0",
    "build": "storybook build --output-dir ./build",
    "storybook": "storybook dev -p 6006 --no-open",
    "clean": "rimraf ./build",
    "clean:all": "git clean -fdX ."
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/utils": "^9.5.0",
    "@sheetxl/grid-react": "^1.0.3",
    "@sheetxl/io": "workspace:*",
    "@sheetxl/react": "^1.0.3",
    "@sheetxl/sdk": "^1.0.3",
    "@sheetxl/studio-mui": "workspace:*",
    "@sheetxl/utils": "workspace:*",
    "@sheetxl/utils-mui": "workspace:*",
    "@sheetxl/utils-react": "workspace:*",
    "http-server": "^14.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "10.6.7",
    "globals": "^17.14.0",
    "storybook": "10.6.7",
    "vite": "~8.1.6"
  }
}
