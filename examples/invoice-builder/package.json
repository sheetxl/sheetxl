{
  "name": "example-invoice-builder",
  "description": "Example app that uses SheetXL as the engine and live preview behind its own form",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf ./build",
    "clean:all": "git clean -fdX .",
    "lint": "eslint ."
  },
  "sheetxl": {
    "demo": {
      "title": "Invoice Builder",
      "description": "Your form, our engine. A plain React form drives a live, protected invoice with real formulas, a growing table and a genuine Excel export.",
      "thumb": "demo-thumb.png"
    }
  },
  "dependencies": {
    "@sheetxl/grid-react": "^1.0.3",
    "@sheetxl/io": "workspace:*",
    "@sheetxl/primitives": "workspace:*",
    "@sheetxl/react": "^1.0.3",
    "@sheetxl/scripting": "^1.0.3",
    "@sheetxl/sdk": "^1.0.3",
    "@sheetxl/utils": "workspace:*",
    "@sheetxl/utils-react": "workspace:*",
    "csstype": "^3.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "vite": "~8.1.6"
  }
}
