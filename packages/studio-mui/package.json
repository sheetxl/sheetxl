{
  "name": "@sheetxl/studio-mui",
  "version": "0.0.0",
  "description": "Studio - Spreadsheet UI built with SheetXL SDK using React & MUI.",
  "homepage": "https://sheetxl.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sheetxl/sheetxl.git"
  },
  "bugs": {
    "url": "https://github.com/sheetxl/sheetxl/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./build/types/index.d.ts",
      "import": {
        "node": "./build/node/esm/index.mjs",
        "browser": "./build/browser/esm/index.mjs",
        "default": "./build/browser/esm/index.mjs"
      }
    }
  },
  "scripts": {
    "build:node": "cross-env BUILD_ENV=node vite build",
    "build:browser": "vite build",
    "build": "pnpm run build:node && pnpm run build:browser",
    "build:tsdocs:json": "pnpm -w exec typedoc --options packages/studio-mui/typedoc.json --json build/docs-json/studio-mui.json --tsconfig packages/studio-mui/tsconfig.build.json",
    "clean": "rimraf ./build",
    "clean:all": "git clean -fdX .",
    "release:package": "cd build && pnpm publish --no-git-checks --access public",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sheetxl/grid-react": "^1.0.3",
    "@sheetxl/io": "workspace:*",
    "@sheetxl/react": "^1.0.3",
    "@sheetxl/scripting-react": "^1.0.3",
    "@sheetxl/sdk": "^1.0.3",
    "@sheetxl/utils": "workspace:*",
    "@sheetxl/utils-mui": "workspace:*",
    "@sheetxl/utils-react": "workspace:*",
    "clsx": "^2.1.1",
    "csstype": "^3.2.3",
    "file-saver": "^2.0.5",
    "notistack": "^3.0.2",
    "react-hook-form": "^7.91.0",
    "react-merge-refs": "^3.0.2",
    "react-transition-group": "^4.4.5",
    "rooks": "^9.9.0",
    "tinycolor2": "^1.6.0"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.0.0",
    "@mui/styled-engine": "^9.0.0",
    "@mui/system": "^9.0.0",
    "@mui/utils": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12"
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "sheetxl",
    "spreadsheet",
    "javascript",
    "typescript",
    "data grid",
    "excel",
    "xlsx",
    "utilities",
    "sheets",
    "grid",
    "react",
    "material",
    "material-ui",
    "mui",
    "office",
    "automation",
    "charting"
  ],
  "privateRepo": false
}
