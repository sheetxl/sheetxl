    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^5.9.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0 || ^6.0.0"
  },
  "keywords": [
    "sheetxl",
