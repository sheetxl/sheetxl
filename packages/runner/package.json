{
  "name": "@sheetxl/runner",
  "version": "0.0.0",
  "description": "SheetXL - Programmatic execution for SheetXL scripts",
  "homepage": "https://sheetxl.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sheetxl/sheetxl.git"
  },
  "bugs": {
