{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "rootDir": "../..",
    "paths": {
      "@sheetxl/primitives": [
        "../primitives/src"
      ],
      "@sheetxl/utils": [
        "../utils/src"
      ]
    },
    "tsBuildInfoFile": "./build/.tsbuildinfo.cli"
  },
