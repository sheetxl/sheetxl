{
  "name": "@sheetxl/scripting-mui",
  "version": "0.0.0",
  "description": "Scripting MUI - MUI script workspace, toolbar and run-script plugin for SheetXL.",
  "homepage": "https://sheetxl.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sheetxl/sheetxl.git"
  },
  "bugs": {
    "url": "https://github.com/sheetxl/sheetxl/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./build/types/index.d.ts",
      "import": {
        "node": "./build/node/esm/index.mjs",
        "browser": "./build/browser/esm/index.mjs",
        "default": "./build/browser/esm/index.mjs"
      }
    }
  },
  "scripts": {
    "build:node": "cross-env BUILD_ENV=node vite build",
    "build:browser": "vite build",
    "build": "pnpm run build:node && pnpm run build:browser",
    "build:tsdocs:json": "pnpm -w exec typedoc --options packages/scripting-mui/typedoc.json --json build/docs-json/scripting-mui.json --tsconfig packages/scripting-mui/tsconfig.build.json",
    "clean": "rimraf ./build",
    "clean:all": "git clean -fdX .",
    "release:package": "cd build && pnpm publish --no-git-checks --access public",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sheetxl/react": "^1.0.3",
    "@sheetxl/scripting-react": "^1.0.3",
    "@sheetxl/sdk": "^1.0.3",
    "@sheetxl/studio-mui": "workspace:*",
    "@sheetxl/utils": "workspace:*",
    "@sheetxl/utils-mui": "workspace:*",
    "@sheetxl/utils-react": "workspace:*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.0.0",
    "@mui/styled-engine": "^9.0.0",
    "@mui/system": "^9.0.0",
    "@mui/utils": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "sheetxl",
    "spreadsheet",
    "react",
    "mui",
    "scripting",
    "macros",
    "automation"
  ],
  "privateRepo": false
}
