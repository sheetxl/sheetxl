{
  "redirects": [
    { "source": "/docs", "destination": "https://docs.sheetxl.com/", "permanent": true },
    { "source": "/docs/(.*)", "destination": "https://docs.sheetxl.com/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/examples/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
