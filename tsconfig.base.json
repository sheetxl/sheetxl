{
  "compilerOptions": {
    // A few demo apps under examples/ opt OUT with their own "strict": false.
    "strict": true,

    "resolveJsonModule": true,

    "outDir": "./build",
    "tsBuildInfoFile": "./build/.tsbuildinfo",
    "declarationDir": "./build/types",

    "target": "ESNext",

    "module": "ESNext",
    "moduleResolution": "bundler",

    // For node and browser. `esnext.disposable` is listed explicitly because `using`/`Symbol.dispose`
    // is a language feature we use (collections/IteratorUtils);
    "lib": ["es2022", "esnext.disposable", "dom"],

    // No ambient `@types/*` package is included unless a tsconfig asks for it by name. TypeScript's
    // default is to auto-include everything visible under `node_modules/@types`, which in a pnpm
    // monorepo makes a program's ambient surface depend on which package happens to hoist what -
    // `Buffer`/`process` type-checked in browser-only code purely because a transitive `@types`
    // package carried a `/// <reference types="node" />`. Node packages opt in with `"types": ["node"]`.
    "types": [],

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    // Prevent .d.ts files in source
    "emitDeclarationOnly": false,
    "removeComments": false,
    "preserveConstEnums": true,
    "useDefineForClassFields": false, // **Performance** - setting to `true` has huge performance costs.
  },
  "exclude": [
    "**.test.**",
    "**/__tests__/**",
    "**/.pnpm",
    "**/build",
    "**/dist",
    "**/node_modules"
  ]
}