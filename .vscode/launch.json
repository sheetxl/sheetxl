{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Example - UI",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/examples",
      "runtimeArgs": [
        "--profile-directory=debug-profile",
        "--preserve-symlinks",
        "--js-flags=--allow-natives-syntax --trace-gc --trace-gc-verbose"
      ],
      "pathMapping": {
        "/@fs/": ""
      },
      "skipFiles": [
        // Skip all files from node_modules, including packages linked by pnpm
        "${workspaceFolder}/**/node_modules/**",
        // Also keep skipping Node.js internal modules
        "<node_internals>/**"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Example - Studio ESM",
      "url": "http://localhost:4000",
      "webRoot": "${workspaceFolder}/examples/studio-vanilla",
      "runtimeArgs": [
        "--profile-directory=debug-profile",
        "--preserve-symlinks",
        "--js-flags=--allow-natives-syntax --trace-gc --trace-gc-verbose"
      ],
      "pathMapping": {
        "/@fs/": ""
      },
      "skipFiles": [
        // Skip all files from node_modules, including packages linked by pnpm
        "${workspaceFolder}/**/node_modules/**",
        // Also keep skipping Node.js internal modules
        "<node_internals>/**"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Example - Storybook",
      "url": "http://localhost:6006",
      "webRoot": "${workspaceFolder}/examples/storybook",
      "runtimeArgs": [
        "--profile-directory=debug-profile"
      ],
      "pathMapping": {
        "/@fs/": ""
      },
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "CLI - Repl",
      "runtimeExecutable": "tsx",
      "args": ["${workspaceFolder}/packages/cli/scripts/dev-cli.mts"], // as repl
      // "args": ["src/cli.ts", "activate"], // as repl
      // "args": ["src/cli.ts", "activate", "sdfsdfds"], // as repl
      // "args": ["src/cli.ts", "repl"], // as repl
      // "args": ["src/cli.ts", "repl", "assets/simple.xlsx"], // as repl
      // "args": ["src/cli.ts", "repl", "assets/simple.xlsx"], // as repl
      // "args": ["src/cli.ts", "repl", "https://www.sheetxl.com/docs/examples/loan-calculator.xlsx"], // as repl
      // "args": ["src/cli.ts", "license"], // as repl
      // "args": ["src/cli.ts", "extract", "assets/simple.xlsx"],
      "cwd": "${workspaceFolder}/packages/cli",
      // `--conditions=development` resolves @sheetxl/* to src, so these launches debug SOURCE. That
      // source imports the vite-only `virtual:sheetxl/bundled-locale`, which node cannot resolve —
      // `scripts/dev-cli.mts` registers the hooks that stand in for the vite plugin and then hands off
      // to `src/cli.ts`. It carries that preload itself (rather than a `--import=` here) so `cwd` is
      // free to be any directory you want to run the CLI from.
      // Flags belong on the runtime, NOT in `env.NODE_OPTIONS`: `integratedTerminal` sets env on the
      // TERMINAL, so a NODE_OPTIONS there outlives the debug session and hits every later node command.
      "runtimeArgs": ["--conditions=development"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "CLI - Command",
      "runtimeExecutable": "tsx",
      // "args": ["${workspaceFolder}/packages/cli/scripts/dev-cli.mts", "-f", "scripts/simple-script.ts", "--in", "grep/budget.xlsx", "--", "--testing=true", "-test2=123"],
      // Scripts arrive through `-f`, which is repeatable for a pipeline; a positional is the WORKBOOK.
      "args": ["${workspaceFolder}/packages/cli/scripts/dev-cli.mts", "-f", "scripts/report-errors.ts", "-f", "scripts/simple-script.ts"],
      // cwd is the EXAMPLE dir, not the cli package — relative args resolve the way they do in a terminal.
      "cwd": "${workspaceFolder}/examples/cli",
      "runtimeArgs": ["--conditions=development"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "CLI - Test to Excel",
      "runtimeExecutable": "tsx",
      // Run with a fixture JSON open in the editor: SHEETXL_IN pins the fixture root, so
      // `${fileDirnameBasename}/${fileBasename}` addresses it as e.g. `statistical/AVEDEV.json`.
      "args": ["${workspaceFolder}/packages/cli/scripts/dev-cli.mts", "-f", "scripts/test-to-xlsx.ts", "--out", "${fileBasenameNoExtension}.xlsx", "--", "--test", "${fileDirnameBasename}/${fileBasename}"],
      // cwd is the EXAMPLE dir, not the cli package — relative args resolve the way they do in a terminal.
      "cwd": "${workspaceFolder}/examples/cli",
      "runtimeArgs": ["--conditions=development"],
      "env": {
        "NODE_ENV": "development",
        "SHEETXL_IN": "${workspaceFolder}/packages/sdk/src/__tests__/functions",
        "SHEETXL_OUT": "${workspaceFolder}/packages/sdk/build/test-xlsx"
      },
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest - {CurrentFile}",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"], // , "**/node_modules/**"
      "program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "smartStep": true,
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest - Debug Tests",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--reporter=verbose"],
      "env": {
        "NODE_ENV": "debug"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest - Debug {CurrentFile}",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}", "--reporter=verbose"],
      "env": {
        "NODE_ENV": "debug"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "assetName",
      "description": "Name of file.",
      "default": "simple"
    }
  ]
}
