{
  "name": "@sheetxl/monorepo",
  "description": "SheetXL monorepo.",
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo monorepo does not have a dev script; try 'dev:studio-mui', 'dev:docsite', or 'dev:storybook'",
    "start": "echo monorepo does not have a start script; try 'dev:studio-mui', 'dev:docsite', or 'dev:storybook'",
    "dev:mcp": "pnpm --filter ./packages/mcp dev",
    "dev:studio-mui": "pnpm --filter ./examples/studio-mui dev",
    "dev:docsite": "pnpm --filter ./docsite dev",
    "dev:storybook": "pnpm --filter ./examples/storybook dev",
    "build": "pnpm run clean:packages && pnpm run build:incremental",
    "build:incremental": "pnpm -r --workspace-concurrency=1 --bail --filter=\"./packages/*\" build",
    "build:docsite": "pnpm --filter ./docsite build",
    "build:tsdocs:json": "pnpm --filter=\"./packages/*\" build:tsdocs:json",
    "build:tsdocs:merge": "typedoc -favicon ./static/img/favicon.ico --excludeInternal --entryPointStrategy merge \"./build/docs-json/*.json\"",
    "build:tsdocs": "pnpm run build:tsdocs:json && pnpm run build:tsdocs:merge && node ./config/TsDocInjectNoIndex.ts && node ./config/TsDocChannelLinks.ts",
    "build:studio-mui": "pnpm --filter ./examples/studio-mui build",
    "build:storybook": "pnpm --filter ./examples/storybook build",
    "build:demos": "node ./config/buildDemos.ts",
    "preview:demos": "vite preview --outDir ./build/demos --port 4173",
    "clean": "rimraf ./build && pnpm -r clean",
    "clean:packages": "pnpm -r --filter=\"./packages/*\" clean",
    "clean:tsdocs": "rimraf ./build/docs ./build/docs-json",
    "clean:all": "git clean -fdX .",
    "release:public-repo": "rimraf ../deploy-repos && node ./config/publishPublicRepo.ts",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:checks": "node scripts/run-checks.mjs",
    "i18n:lint": "node scripts/i18n-extract.mjs && pnpm i18n:checks",
    "i18n:ci": "node scripts/run-checks.mjs --check-extract",
    "i18n:fix": "node scripts/i18n-extract.mjs && node scripts/i18n-catalog.mjs --sync",
    "validate": "pnpm i18n:ci && pnpm lint && pnpm test:all",
    "validate:full": "pnpm i18n:ci && pnpm lint && pnpm build && pnpm test:all",
    "prepare": "husky",
    "i18n:chrome": "node scripts/i18n-chrome-lint.mjs",
    "lint": "node scripts/audit-css-vars.mjs && eslint --cache --quiet .",
    "lint:full": "eslint --cache --max-warnings 10000 .",
    "audit:css-vars": "node scripts/audit-css-vars.mjs",
    "audit:ambient-types": "node scripts/check-ambient-types.mjs",
    "format": "prettier --ignore-path .eslintignore --write .",
    "format:check": "prettier --ignore-path .eslintignore --check .",
    "test": "vitest run",
    "test:all": "cross-env SHEETXL_TEST_FORMULAS=all vitest run",
    "test:formulas": "cross-env SHEETXL_TEST_FORMULAS=only vitest run",
    "test:watch": "vitest watch",
    "test:node": "vitest --config vitest.node.config.ts",
    "test:jsdom": "vitest --config vitest.jsdom.config.ts",
    "test:coverage": "cross-env SHEETXL_TEST_FORMULAS=all vitest run --coverage",
    "test:coverage:node": "vitest run --coverage --config vitest.node.config.ts",
    "test:coverage:jsdom": "vitest run --coverage --config vitest.jsdom.config.ts",
    "preview:tsdocs": "npx http-server ./build/docs -p 3200 -c-1 --cors",
    "preview:docsite": "pnpm --filter ./docsite preview",
    "preview:studio": "pnpm --filter ./examples/studio-mui preview",
    "preview:storybook": "pnpm --filter ./examples/storybook preview",
    "sheetxl": "node ./scripts/sheetxl-local/bin.mjs",
    "publish": "echo 'Use release",
    "release:packages": "node ./config/releasePackages.ts",
    "registry:local": "node ./config/localRegistry.ts",
    "release:local": "node ./config/publishLocal.ts",
    "release": "pnpm semantic-release --extends ./config/release.config.ts",
    "release:no-ci": "cross-env GITHUB_TOKEN=fake pnpm semantic-release --extends ./config/release.config.ts --no-ci",
    "release:test": "cross-env GITHUB_TOKEN=fake pnpm semantic-release --extends ./config/release.config.ts --no-ci --dry-run",
    "i18n:catalog": "node scripts/i18n-catalog.mjs",
    "i18n:catalog:check": "node scripts/i18n-catalog.mjs --check",
    "cmd:chords": "node scripts/command-chord-lint.mjs",
    "release:check": "node ./config/checkReleaseTargets.ts",
    "release:targets:sync": "node ./config/checkReleaseTargets.ts --fix",
    "release:public-repo:dry-run": "rimraf ../deploy-repos && node ./config/publishPublicRepo.ts --dry-run"
  },
  "lint-staged": {
    "*.{ts,tsx,cts,mts,js,cjs,mjs}": [
      "eslint --cache --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@csstools/css-parser-algorithms": "^4.0.2",
    "@csstools/css-tokenizer": "^4.0.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-url": "^8.0.2",
    "@rollup/pluginutils": "^5.5.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "5.1.0",
    "auto-changelog": "^2.7.0",
    "chalk": "^6.0.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "execa": "^10.2.1",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.4",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.10.0",
    "jsdom": "^30.1.2",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.4",
    "rolldown": "~1.2.13",
    "rollup": "^4.68.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-license": "^3.7.2",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-visualizer": "^7.1.3",
    "semantic-release": "^25.0.9",
    "semgrep": "^0.0.1",
    "semver": "^7.8.6",
    "svgo": "^3.3.5",
    "terser": "5.49.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "~8.1.6",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.12.3",
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "rolldown": "~1.2.0",
      "terser": "5.49.0",
      "conventional-changelog-conventionalcommits>@conventional-changelog/template": "1.2.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "marked-terminal>marked": "17",
        "eslint-plugin-react>eslint": "10",
        "@napi-rs/wasm-runtime>@emnapi/core": "1",
        "@napi-rs/wasm-runtime>@emnapi/runtime": "1"
      }
    }
  },
  "engines": {
    "node": "^22.22.2 || >=24.15",
    "pnpm": ">=10"
  },
  "engineStrict": true
}
